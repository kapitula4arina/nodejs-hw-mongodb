{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Contacts app",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "API service for managing a personal contact list with secure access."
  },
  "servers": [
    {
      "url": "http://localhost:4000"
    },
    {
      "url": "https://contacts-app-22zj.onrender.com"
    }
  ],
  "tags": [
    {
      "name": "Contacts",
      "description": "Endpoints for working with user contacts"
    },
    {
      "name": "Authentication",
      "description": "Endpoints for user sign-up, login, and token management"
    }
  ],
  "paths": {
    "/contacts": {
      "get": {
        "tags": ["Contacts"],
        "summary": "Get list of contacts",
        "operationId": "getContacts",
        "description": "Get contacts records. You can use query parameters",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "description": "Page number for pagination.",
            "schema": {
              "type": "integer",
              "example": 1,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "perPage",
            "description": "Number of contacts to return per page.",
            "schema": {
              "type": "integer",
              "example": 5,
              "default": 10
            }
          },
          {
            "in": "query",
            "name": "sortBy",
            "description": "Field to sort contacts by.",
            "schema": {
              "type": "string",
              "enum": [
                "_id",
                "name",
                "phoneNumber",
                "contactType",
                "isFavourite"
              ],
              "example": "name",
              "default": "_id"
            }
          },
          {
            "in": "query",
            "name": "sortOrder",
            "description": "Sort direction ascending or descending.",
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"],
              "default": "asc",
              "example": "asc"
            }
          },
          {
            "in": "query",
            "name": "isFavourite",
            "description": "Filter by favorite status (true or false).",
            "schema": {
              "type": "boolean",
              "example": true
            }
          },
          {
            "in": "query",
            "name": "contactType",
            "description": "Filter by contact type.",
            "schema": {
              "type": "string",
              "enum": ["work", "home", "personal"],
              "example": "home"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved contacts.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "message", "data"],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully found contacts!"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "data",
                        "page",
                        "perPage",
                        "totalItems",
                        "totalPages",
                        "hasPreviousPage",
                        "hasNextPage"
                      ],
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/contact"
                          }
                        },
                        "page": {
                          "type": "integer",
                          "example": 1
                        },
                        "perPage": {
                          "type": "integer",
                          "example": 10
                        },
                        "totalItems": {
                          "type": "integer",
                          "example": 4
                        },
                        "totalPages": {
                          "type": "integer",
                          "example": 1
                        },
                        "hasPreviousPage": {
                          "type": "boolean",
                          "example": false
                        },
                        "hasNextPage": {
                          "type": "boolean",
                          "example": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          }
        }
      },
      "post": {
        "tags": ["Contacts"],
        "summary": "Create contact",
        "operationId": "createContact",
        "description": "Create a new contact with name, phone number, and optional fields like email, contact type, or photo.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["name", "phoneNumber"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Contact name.",
                    "example": "John Doe"
                  },
                  "phoneNumber": {
                    "type": "string",
                    "description": "Contact phone number.",
                    "example": "+380970002219"
                  },
                  "email": {
                    "type": "string",
                    "description": "Contact email address.",
                    "format": "email",
                    "example": "john.doe@example.com"
                  },
                  "isFavourite": {
                    "type": "boolean",
                    "description": "Mark contact as favorite.",
                    "example": true
                  },
                  "contactType": {
                    "type": "string",
                    "description": "Contact type.",
                    "enum": ["work", "home", "personal"],
                    "example": "personal"
                  },
                  "photo": {
                    "type": "string",
                    "description": "(Optional) Contact photo.",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successfully created a contact.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "message", "data"],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 201
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully created a contact!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/contact"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          }
        }
      }
    },
    "/contacts/{id}": {
      "get": {
        "tags": ["Contacts"],
        "summary": "Get contact by id",
        "operationId": "getContactById",
        "description": "Retrieve a single contact using its unique ID.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "description": "Unique identifier of the contact to retrieve.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "6635e91f5a68c52f2dc7b7c8"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contact retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "message", "data"],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "description": "Response status message.",
                      "example": "Successfully found contact with id 6635e91f5a68c52f2dc7b7c8!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/contact"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      },
      "patch": {
        "tags": ["Contacts"],
        "summary": "Update contact by ID",
        "operationId": "patchContact",
        "description": "Partially update an existing contact by providing one or more fields.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The unique ID of the contact to update.",
            "schema": {
              "type": "string",
              "example": "6641f3a2d9b7c8ef12a34567"
            }
          }
        ],
        "requestBody": {
          "description": "Contact fields to update. At least one field must be provided.",
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "description": "Updated contact name.",
                    "type": "string",
                    "example": "Alice Smith"
                  },
                  "phoneNumber": {
                    "description": "Updated phone number.",
                    "type": "string",
                    "example": "+380631234567"
                  },
                  "email": {
                    "description": "Updated email address.",
                    "type": "string",
                    "format": "email",
                    "example": "alice.smith@example.com"
                  },
                  "isFavourite": {
                    "description": "Set contact as favorite or not.",
                    "type": "boolean",
                    "example": true
                  },
                  "contactType": {
                    "description": "Updated contact type.",
                    "type": "string",
                    "enum": ["work", "home", "personal"],
                    "example": "work"
                  },
                  "photo": {
                    "description": "Upload a new photo file for the contact.",
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully patched the contact. Returns updated contact data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "message", "data"],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully patched a contact!"
                    },
                    "data": {
                      "$ref": "#/components/schemas/contact"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      },
      "delete": {
        "tags": ["Contacts"],
        "summary": "Delete contact by id",
        "operationId": "deleteContact",
        "description": "Deletes a contact by its unique identifier.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "example": "6635e91f5a68c52f2dc7b7c8"
            },
            "description": "Unique contact ID to delete."
          }
        ],
        "responses": {
          "204": {
            "description": "Contact was successfully deleted. No content is returned."
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "contact": {
        "type": "object",
        "required": ["name", "phoneNumber"],
        "properties": {
          "_id": {
            "description": "Contact id.",
            "type": "string",
            "example": "6635e91f5a68c52f2dc7b7c8"
          },
          "name": {
            "description": "Contact name.",
            "type": "string",
            "example": "John Doe"
          },
          "phoneNumber": {
            "description": "Contact phone number.",
            "type": "string",
            "example": "+380991234567"
          },
          "email": {
            "description": "Contact email address.",
            "type": "string",
            "example": "john@example.com"
          },
          "isFavourite": {
            "description": "Contact`s favorite status",
            "type": "boolean",
            "example": true
          },
          "contactType": {
            "description": "Contact type.",
            "type": "string",
            "enum": ["work", "home", "personal"]
          },
          "userId": {
            "description": "Contact user id.",
            "type": "string",
            "example": "661fc5124c8a57123f8824b3"
          },
          "photo": {
            "description": "Contact photo.",
            "type": "string",
            "example": "https://res.cloudinary.com/uqwgdu/image/upload/image.png"
          }
        }
      }
    },
    "responses": {
      "400": {
        "description": "Bad Request",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["status", "message", "data"],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 400
                },
                "message": {
                  "type": "string",
                  "example": "Bad Request. Invalid parameter."
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Invalid or missing parameters."
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["message", "path"],
                        "properties": {
                          "message": {
                            "type": "string",
                            "example": "Username is required"
                          },
                          "path": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "example": ["name"]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["status", "message", "data"],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 401
                },
                "message": {
                  "type": "string",
                  "example": "UnauthorizedError"
                },
                "data": {
                  "type": "object",
                  "required": ["message"],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Access token expired"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "Not Fount Error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["status", "message", "data"],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 404
                },
                "message": {
                  "type": "string",
                  "example": "NotFoundError"
                },
                "data": {
                  "type": "object",
                  "required": ["message"],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Contact not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
